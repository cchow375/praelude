{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["nsis"],
    "resources": [
      "assets/clicks/*.wav",
      "../THIRD_PARTY_NOTICES.txt"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "startMenuFolder": "Praelude",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
