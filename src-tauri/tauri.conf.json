{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CodaKiller",
  "version": "0.4.0",
  "identifier": "com.christian.codakiller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CodaKiller",
        "width": 1280,
        "height": 820,
        "minWidth": 980
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": ["assets/clicks/*.wav", "../vendor/bin/hear"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
