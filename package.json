{
  "name": "praelude",
  "private": true,
  "version": "11.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "bash scripts/bootstrap-macos.sh --check",
    "setup:mac": "bash scripts/bootstrap-macos.sh",
    "docs:sync": "bash scripts/sync-project-docs.sh --sync",
    "docs:check": "bash scripts/sync-project-docs.sh --check",
    "project:check": "bash scripts/check-project-portability.sh",
    "dev": "vite",
    "dev:mock": "VITE_DEV_MOCK=1 vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tauri": "tauri",
    "release:mac": "bash 'scripts/(C) release-macos.sh'",
    "package:mac": "bash scripts/package-macos.sh",
    "qa:shots": "bash scripts/qa-shots.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "pdfjs-dist": "6.1.200",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
